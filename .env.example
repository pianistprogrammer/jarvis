# The Node/UI server
PORT=4100

# llama.cpp's OpenAI-compatible endpoint
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-no-key
LLM_MODEL=qwen-local
LLM_CONTEXT_SIZE=65536

# auto selects the Qwen3.8 9B Distill profile; override with compact or full as needed.
# Override with MODEL_PROFILE=compact or MODEL_PROFILE=full.
MODEL_PROFILE=auto

# MLX-Audio's OpenAI-compatible speech endpoints
STT_URL=http://127.0.0.1:8000/v1/audio/transcriptions
# Leave STT_MODEL unset for automatic selection: Whisper Small Q4 on compact
# machines and Whisper Large-v3 Turbo FP16 on machines with 32 GB or more.
# STT_MODEL=mlx-community/whisper-small-mlx-q4
TTS_URL=http://127.0.0.1:8000/v1/audio/speech
TTS_PROVIDER=kokoro
TTS_MODEL=mlx-community/Kokoro-82M-4bit
TTS_VOICE=af_heart
TTS_LANG_CODE=en
# To switch to Qwen3-TTS, use:
# TTS_PROVIDER=qwen3-tts
# TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit
# TTS_VOICE=Ryan
# TTS_LANG_CODE=English
TTS_TEMPERATURE=0.35
TTS_TOP_P=0.9
TTS_TOP_K=20
TTS_REPETITION_PENALTY=1.10
TTS_SPEED=1.0
TTS_STREAMING_INTERVAL=0.32
# Keep this voice card stable and agent-like; customize only if needed.
TTS_INSTRUCT="Neutral, clear speech, steady pacing."

# Tools are constrained to this project-relative directory by default.
AGENT_WORKSPACE=./workspace
BROWSER_PROFILE=./data/browser-profile
BROWSER_HEADLESS=true
BROWSER_USER=agent
BROWSER_PASSWORD=change-me

# Optional comma-separated host names. Empty allows any HTTP(S) domain.
# Example: BROWSER_ALLOWLIST=github.com,*.wikipedia.org
BROWSER_ALLOWLIST=
