{
  "name": "macos-voice-agent",
  "private": false,
  "version": "0.1.0",
  "description": "A local-first, near real-time voice agent for Apple silicon with browser and workspace tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "check": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:mac": "bash scripts/setup-macos.sh",
    "models:start": "bash scripts/start-models.sh",
    "launch": "bash scripts/launch.sh",
    "doctor": "bash scripts/doctor.sh",
    "browser:install": "playwright install chromium",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mathjs": "^15.2.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
